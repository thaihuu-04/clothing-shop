@model Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<section class="auth-page">
    <div class="auth-card text-center" style="max-width:560px">
        <div class="display-4 text-success mb-3"><i class="bi bi-check-circle"></i></div>
        <h1>Đặt hàng thành công!</h1>

        <p class="text-muted">
            Cảm ơn bạn đã mua sắm tại Fashion Store. Mã đơn hàng của bạn là
        </p>
        <p class="fs-4 fw-bold">@Model.OrderCode</p>

        <div class="text-start bg-light p-3 small mb-4">
            <div><strong>Tổng thanh toán:</strong> @FormatHelper.Money(Model.TotalAmount)</div>
            <div><strong>Thanh toán:</strong> @PaymentMethods.DisplayName(Model.PaymentMethod)</div>
            @if (Model.Address != null)
            {
                <div><strong>Giao tới:</strong> @Model.Address.ReceiverName - @Model.Address.Phone, @Model.Address.AddressDetail, @Model.Address.Ward, @Model.Address.District, @Model.Address.Province</div>
            }
            @if (Model.PaymentMethod == PaymentMethods.BankTransfer)
            {
                <div class="mt-2 text-danger">
                    Vui lòng chuyển khoản tới STK 0123456789 - Ngân hàng ABC với nội dung <strong>@Model.OrderCode</strong>.
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn-shop flex-fill">Xem đơn hàng</a>
            <a asp-controller="Products" asp-action="Index" class="btn-shop btn-shop-outline flex-fill">Tiếp tục mua sắm</a>
        </div>
    </div>
</section>
