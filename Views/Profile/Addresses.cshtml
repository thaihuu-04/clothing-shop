@model List<Address>
@{
    ViewData["Title"] = "Sổ địa chỉ";
}

<div class="page-wrapper">
    <div class="row g-5">
        <div class="col-lg-3">
            <partial name="_AccountMenu" model="@("addresses")" />
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="page-title mb-0">Sổ địa chỉ</h1>
                <a asp-action="CreateAddress" class="btn-shop"><i class="bi bi-plus-lg"></i> Thêm địa chỉ</a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-geo-alt"></i>
                    <p>Bạn chưa có địa chỉ nào.</p>
                </div>
            }

            @foreach (var a in Model)
            {
                <div class="shop-card d-flex justify-content-between flex-wrap gap-3">
                    <div>
                        <div>
                            <strong>@a.ReceiverName</strong> · @a.Phone
                            @if (a.IsDefault)
                            {
                                <span class="badge bg-dark ms-1">Mặc định</span>
                            }
                        </div>
                        <div class="text-muted small">@a.AddressDetail, @a.Ward, @a.District, @a.Province</div>
                    </div>

                    <div class="d-flex gap-2 align-items-start">
                        @if (!a.IsDefault)
                        {
                            <form asp-action="SetDefaultAddress" asp-route-id="@a.AddressId" method="post">
                                <button class="btn btn-sm btn-outline-dark rounded-0">Đặt mặc định</button>
                            </form>
                        }
                        <a asp-action="EditAddress" asp-route-id="@a.AddressId" class="btn btn-sm btn-dark rounded-0">Sửa</a>
                        <form asp-action="DeleteAddress" asp-route-id="@a.AddressId" method="post"
                              data-confirm="Xóa địa chỉ này?">
                            <button class="btn btn-sm btn-outline-danger rounded-0">Xóa</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
