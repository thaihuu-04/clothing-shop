@model List<Category>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Danh mục <span class="text-muted fs-6">(@Model.Count)</span></h4>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Thêm danh mục</a>
</div>

<div class="admin-card p-0">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Ảnh</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th class="text-center">Số sản phẩm</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="@(c.IsActive ? "" : "opacity-50")">
                    <td><img src="@(c.ImageUrl ?? "/images/no-image.svg")" class="admin-thumb" alt="" /></td>
                    <td class="fw-semibold">@c.CategoryName</td>
                    <td class="small text-muted">@c.Description</td>
                    <td class="text-center">@c.Products.Count</td>
                    <td class="text-center">
                        <form asp-action="ToggleActive" asp-route-id="@c.CategoryId" method="post">
                            <button class="btn btn-sm @(c.IsActive ? "btn-success" : "btn-secondary")">
                                @(c.IsActive ? "Hiển thị" : "Đang ẩn")
                            </button>
                        </form>
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                              data-confirm="Xóa danh mục @c.CategoryName?">
                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
