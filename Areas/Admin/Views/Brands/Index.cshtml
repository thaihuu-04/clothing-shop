@model List<Brand>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Thương hiệu <span class="text-muted fs-6">(@Model.Count)</span></h4>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Thêm thương hiệu</a>
</div>

<div class="admin-card p-0">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Logo</th>
                <th>Tên thương hiệu</th>
                <th>Mô tả</th>
                <th class="text-center">Số sản phẩm</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr class="@(b.IsActive ? "" : "opacity-50")">
                    <td>
                        @if (!string.IsNullOrEmpty(b.LogoUrl))
                        {
                            <img src="@b.LogoUrl" style="height:40px;max-width:90px;object-fit:contain" alt="" />
                        }
                        else
                        {
                            <span class="badge bg-dark">@b.BrandName[..Math.Min(2, b.BrandName.Length)].ToUpper()</span>
                        }
                    </td>
                    <td class="fw-semibold">@b.BrandName</td>
                    <td class="small text-muted">@b.Description</td>
                    <td class="text-center">@b.Products.Count</td>
                    <td class="text-center">
                        <form asp-action="ToggleActive" asp-route-id="@b.BrandId" method="post">
                            <button class="btn btn-sm @(b.IsActive ? "btn-success" : "btn-secondary")">
                                @(b.IsActive ? "Hoạt động" : "Tạm ngưng")
                            </button>
                        </form>
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@b.BrandId" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@b.BrandId" method="post" class="d-inline"
                              data-confirm="Xóa thương hiệu @b.BrandName?">
                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
