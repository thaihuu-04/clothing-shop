@model PagedList<Order>
@{
    string? status = ViewBag.Status;
    var counts = (Dictionary<string, int>)ViewBag.StatusCounts;
}

<h4 class="mb-3">Đơn hàng <span class="text-muted fs-6">(@Model.TotalCount)</span></h4>

<ul class="nav nav-pills mb-3 gap-1">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(status) ? "active bg-dark" : "text-dark")" asp-action="Index">
            Tất cả <span class="badge bg-secondary">@counts.Values.Sum()</span>
        </a>
    </li>
    @foreach (var s in OrderStatus.All)
    {
        <li class="nav-item">
            <a class="nav-link @(status == s ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-status="@s">
                @s <span class="badge @OrderStatus.BadgeClass(s)">@(counts.GetValueOrDefault(s))</span>
            </a>
        </li>
    }
</ul>

<form method="get" class="admin-card row g-2 align-items-end">
    <input type="hidden" name="status" value="@status" />
    <div class="col-md-4">
        <label class="form-label small">Tìm kiếm</label>
        <input type="search" name="q" value="@ViewBag.Q" class="form-control" placeholder="Mã đơn, tên khách, SĐT" />
    </div>
    <div class="col-md-3">
        <label class="form-label small">Từ ngày</label>
        <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label small">Đến ngày</label>
        <input type="date" name="to" value="@ViewBag.To" class="form-control" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-dark flex-fill">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
    </div>
</form>

<div class="admin-card p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@o.OrderCode</td>
                        <td>
                            <div>@o.User.FullName</div>
                            <div class="small text-muted">@o.Address?.Phone</div>
                        </td>
                        <td class="small">@FormatHelper.DateTime(o.CreatedAt)</td>
                        <td class="text-end fw-semibold">@FormatHelper.Money(o.TotalAmount)</td>
                        <td>
                            <div class="small">@o.PaymentMethod</div>
                            <span class="badge @(o.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-light text-dark border")">@o.PaymentStatus</span>
                        </td>
                        <td><span class="badge @OrderStatus.BadgeClass(o.OrderStatus)">@o.OrderStatus</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-dark">Chi tiết</a>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn hàng</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var pager = new PagerViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        RouteValuesFor = p => new Dictionary<string, string>
        {
            ["status"] = status ?? "",
            ["q"] = (string?)ViewBag.Q ?? "",
            ["from"] = (string?)ViewBag.From ?? "",
            ["to"] = (string?)ViewBag.To ?? "",
            ["page"] = p.ToString()
        }
    };
}
<partial name="_Pager" model="pager" />
