<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản trị Fashion Store</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();

        string Active(string name) => controller == name ? "active" : "";
    }

    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <aside class="admin-sidebar">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-brand">
                FASHION ADMIN
            </a>

            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@Active("Dashboard")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="@Active("Orders")">
                    <i class="bi bi-receipt"></i> Đơn hàng
                </a>

                <div class="admin-nav-title">Danh mục</div>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="@Active("Products")">
                    <i class="bi bi-box-seam"></i> Sản phẩm
                </a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="@Active("Categories")">
                    <i class="bi bi-tags"></i> Danh mục
                </a>
                <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="@Active("Brands")">
                    <i class="bi bi-award"></i> Thương hiệu
                </a>

                <div class="admin-nav-title">Hệ thống</div>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="@Active("Users")">
                    <i class="bi bi-people"></i> Người dùng
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-shop"></i> Xem website
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <div class="admin-main">
            <header class="admin-topbar">
                <span class="fw-semibold">@ViewData["Title"]</span>

                <div class="d-flex align-items-center gap-3">
                    <span class="small text-muted">
                        <i class="bi bi-person-circle"></i> @User.GetFullName()
                    </span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <main class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
