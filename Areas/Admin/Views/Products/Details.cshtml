@model QA.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container py-5">

    <!-- QUAY LẠI -->
    <div class="mb-4">
        <a asp-controller="Products"
           asp-action="Index"
           class="back-link">
            ← Quay lại cửa hàng
        </a>
    </div>

    <div class="row g-5">

        <!-- ==================== HÌNH ẢNH ==================== -->
        <div class="col-lg-6">

            <div class="product-image-box">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.ProductName"
                         class="product-main-image" />
                }
                else
                {
                    <div class="no-image">
                        <div class="no-image-icon">📷</div>
                        <p>Chưa có hình ảnh sản phẩm</p>
                    </div>
                }

            </div>

        </div>


        <!-- ==================== THÔNG TIN ==================== -->
        <div class="col-lg-6">

            <div class="product-information">

                <div class="product-label">
                    FASHION STORE
                </div>

                <h1 class="product-name">
                    @Model.ProductName
                </h1>


                <!-- GIÁ -->
                <div class="price-section">

                    @if (Model.SalePrice.HasValue &&
                         Model.SalePrice.Value < Model.Price)
                    {
                        <span class="current-price">
                            @Model.SalePrice.Value.ToString("N0") đ
                        </span>

                        <span class="old-price">
                            @Model.Price.ToString("N0") đ
                        </span>

                        <span class="sale-badge">
                            SALE
                        </span>
                    }
                    else
                    {
                        <span class="current-price">
                            @Model.Price.ToString("N0") đ
                        </span>
                    }

                </div>


                <div class="divider"></div>


                <!-- THÔNG TIN SẢN PHẨM -->

                <div class="product-details">

                    <!-- DANH MỤC -->
                    <div class="detail-row">

                        <span class="detail-label">
                            Danh mục
                        </span>

                        <span class="detail-value">
                            @(Model.Category?.CategoryName ?? "Đang cập nhật")
                        </span>

                    </div>


                    <!-- THƯƠNG HIỆU -->
                    <div class="detail-row">

                        <span class="detail-label">
                            Thương hiệu
                        </span>

                        <span class="detail-value">
                            @(Model.Brand?.BrandName ?? "Đang cập nhật")
                        </span>

                    </div>


                    <!-- SIZE -->
                    @if (!string.IsNullOrWhiteSpace(Model.Size))
                    {
                        <div class="detail-row">

                            <span class="detail-label">
                                Kích thước
                            </span>

                            <span class="detail-value">
                                @Model.Size
                            </span>

                        </div>
                    }


                    <!-- MÀU SẮC -->
                    @if (!string.IsNullOrWhiteSpace(Model.Color))
                    {
                        <div class="detail-row">

                            <span class="detail-label">
                                Màu sắc
                            </span>

                            <span class="detail-value">
                                @Model.Color
                            </span>

                        </div>
                    }


                    <!-- CHẤT LIỆU -->
                    @if (!string.IsNullOrWhiteSpace(Model.Material))
                    {
                        <div class="detail-row">

                            <span class="detail-label">
                                Chất liệu
                            </span>

                            <span class="detail-value">
                                @Model.Material
                            </span>

                        </div>
                    }


                    <!-- TỒN KHO -->
                    <div class="detail-row">

                        <span class="detail-label">
                            Tình trạng
                        </span>

                        @if (Model.StockQuantity > 0)
                        {
                            <span class="stock-available">
                                ● Còn hàng
                            </span>
                        }
                        else
                        {
                            <span class="stock-out">
                                ● Hết hàng
                            </span>
                        }

                    </div>

                </div>


                <div class="divider"></div>


                <!-- MÔ TẢ -->
                <div class="description-section">

                    <h3>
                        Mô tả sản phẩm
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p>
                            Sản phẩm thời trang được thiết kế theo phong cách
                            hiện đại, mang đến sự thoải mái và phù hợp với
                            nhiều phong cách khác nhau.
                        </p>
                    }

                </div>


                <!-- NÚT MUA -->

                @if (Model.StockQuantity > 0)
                {
                    <div class="buy-section">

                        <div class="quantity-box">

                            <button type="button"
                                    class="quantity-btn"
                                    onclick="decreaseQuantity()">
                                −
                            </button>

                            <input type="number"
                                   id="quantity"
                                   value="1"
                                   min="1"
                                   max="@Model.StockQuantity"
                                   readonly />

                            <button type="button"
                                    class="quantity-btn"
                                    onclick="increaseQuantity()">
                                +
                            </button>

                        </div>


                        <button type="button"
                                class="add-cart-btn">
                            🛒 Thêm vào giỏ hàng
                        </button>

                    </div>
                }
                else
                {
                    <button type="button"
                            class="out-of-stock-btn"
                            disabled>
                        Hết hàng
                    </button>
                }


                <!-- CAM KẾT -->

                <div class="service-box">

                    <div class="service-item">
                        <span class="service-icon">🚚</span>

                        <div>
                            <strong>Giao hàng toàn quốc</strong>
                            <small>Giao hàng nhanh chóng</small>
                        </div>
                    </div>


                    <div class="service-item">
                        <span class="service-icon">✓</span>

                        <div>
                            <strong>Sản phẩm chính hãng</strong>
                            <small>Cam kết chất lượng</small>
                        </div>
                    </div>


                    <div class="service-item">
                        <span class="service-icon">↩</span>

                        <div>
                            <strong>Đổi trả dễ dàng</strong>
                            <small>Hỗ trợ đổi trả</small>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ==================== CSS ==================== -->

<style>

    /* CONTAINER */

    .product-information {
        padding: 10px 20px;
    }


    /* QUAY LẠI */

    .back-link {
        color: #222;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        transition: 0.2s;
    }

    .back-link:hover {
        color: #666;
    }


    /* HÌNH ẢNH */

    .product-image-box {
        width: 100%;
        height: 650px;
        background: #f5f5f5;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-main-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .product-main-image:hover {
        transform: scale(1.03);
    }


    /* KHÔNG CÓ ẢNH */

    .no-image {
        text-align: center;
        color: #999;
    }

    .no-image-icon {
        font-size: 60px;
        margin-bottom: 10px;
    }


    /* LABEL */

    .product-label {
        display: inline-block;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #777;
        margin-bottom: 15px;
    }


    /* TÊN */

    .product-name {
        font-size: 42px;
        line-height: 1.15;
        font-weight: 700;
        color: #171717;
        margin-bottom: 20px;
    }


    /* GIÁ */

    .price-section {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .current-price {
        font-size: 32px;
        font-weight: 700;
        color: #d92323;
    }

    .old-price {
        font-size: 18px;
        color: #999;
        text-decoration: line-through;
    }

    .sale-badge {
        background: #222;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }


    /* ĐƯỜNG KẺ */

    .divider {
        height: 1px;
        background: #e5e5e5;
        margin: 25px 0;
    }


    /* THÔNG TIN */

    .product-details {
        width: 100%;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-label {
        color: #777;
        font-size: 15px;
    }

    .detail-value {
        color: #222;
        font-weight: 600;
        text-align: right;
    }


    /* TỒN KHO */

    .stock-available {
        color: #198754;
        font-weight: 600;
    }

    .stock-out {
        color: #dc3545;
        font-weight: 600;
    }


    /* MÔ TẢ */

    .description-section h3 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .description-section p {
        color: #666;
        line-height: 1.8;
        margin-bottom: 0;
    }


    /* MUA HÀNG */

    .buy-section {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }


    /* SỐ LƯỢNG */

    .quantity-box {
        height: 55px;
        display: flex;
        border: 1px solid #ddd;
        border-radius: 7px;
        overflow: hidden;
        background: white;
    }

    .quantity-btn {
        width: 45px;
        border: none;
        background: #f5f5f5;
        font-size: 22px;
        cursor: pointer;
    }

    .quantity-btn:hover {
        background: #e9e9e9;
    }

    .quantity-box input {
        width: 50px;
        border: none;
        outline: none;
        text-align: center;
        font-size: 16px;
        font-weight: 600;
    }


    /* THÊM GIỎ */

    .add-cart-btn {
        flex: 1;
        height: 55px;
        border: none;
        border-radius: 7px;
        background: #212529;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .add-cart-btn:hover {
        background: #000;
        transform: translateY(-1px);
    }


    /* HẾT HÀNG */

    .out-of-stock-btn {
        width: 100%;
        height: 55px;
        border: none;
        border-radius: 7px;
        background: #aaa;
        color: white;
        font-size: 16px;
        font-weight: 600;
        margin-top: 25px;
    }


    /* DỊCH VỤ */

    .service-box {
        margin-top: 25px;
        padding: 18px;
        border: 1px solid #eee;
        border-radius: 10px;
        background: #fafafa;
    }

    .service-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 0;
    }

    .service-item:not(:last-child) {
        border-bottom: 1px solid #eee;
    }

    .service-icon {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #222;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .service-item strong {
        display: block;
        font-size: 14px;
        color: #222;
    }

    .service-item small {
        display: block;
        color: #888;
        margin-top: 2px;
    }


    /* RESPONSIVE */

    @@media (max-width: 992px) {

        .product-image-box {
            height: 550px;
        }

        .product-name {
            font-size: 36px;
        }

    }


    @@media (max-width: 768px) {

        .product-image-box {
            height: 450px;
        }

        .product-information {
            padding: 0;
        }

        .product-name {
            font-size: 30px;
        }

        .current-price {
            font-size: 27px;
        }

        .buy-section {
            flex-direction: column;
        }

        .quantity-box {
            width: 100%;
            justify-content: center;
        }

        .add-cart-btn {
            width: 100%;
        }

    }


    @@media (max-width: 480px) {

        .product-image-box {
            height: 380px;
        }

        .product-name {
            font-size: 27px;
        }

        .detail-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

        .detail-value {
            text-align: left;
        }

    }

</style>


<!-- ==================== JAVASCRIPT ==================== -->

<script>

    function decreaseQuantity() {

        const input = document.getElementById("quantity");

        let value = parseInt(input.value);

        if (value > 1) {
            input.value = value - 1;
        }
    }


    function increaseQuantity() {

        const input = document.getElementById("quantity");

        let value = parseInt(input.value);

        let max = parseInt(input.max);

        if (value < max) {
            input.value = value + 1;
        }
    }

</script>