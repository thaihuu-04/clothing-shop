@model Product
@{
    bool hasOrders = ViewBag.HasOrders == true;
}

<div class="admin-card" style="max-width:640px">
    <h5 class="text-danger">Xác nhận xóa sản phẩm</h5>

    <div class="d-flex gap-3 mb-3">
        <img src="@Model.DisplayImage" class="admin-thumb" style="width:90px;height:110px" alt="" />
        <div>
            <div class="fw-semibold fs-5">@Model.ProductName</div>
            <div class="text-muted">@Model.Category?.CategoryName · @Model.Brand?.BrandName</div>
            <div>@FormatHelper.Money(Model.FinalPrice) · Tồn kho: @Model.StockQuantity</div>
        </div>
    </div>

    @if (hasOrders)
    {
        <div class="alert alert-warning">
            Sản phẩm này đã xuất hiện trong đơn hàng nên <strong>không thể xóa vĩnh viễn</strong>.
            Sản phẩm sẽ được chuyển sang trạng thái <strong>ẩn</strong> (không hiển thị cho khách).
        </div>
    }
    else
    {
        <div class="alert alert-danger">Sản phẩm sẽ bị xóa vĩnh viễn và không thể khôi phục.</div>
    }

    <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">@(hasOrders ? "Ẩn sản phẩm" : "Xóa vĩnh viễn")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
