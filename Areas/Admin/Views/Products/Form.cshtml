@model ProductFormViewModel
@{
    bool isEdit = Model.ProductId > 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@(isEdit ? "Sửa sản phẩm #" + Model.ProductId : "Thêm sản phẩm")</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@(isEdit ? Model.ProductId.ToString() : null)"
      method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="admin-card">
                <h5>Thông tin cơ bản</h5>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label"></label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandId" class="form-label"></label>
                        <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                            <option value="">-- Không có --</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Size" class="form-label"></label>
                        <input asp-for="Size" class="form-control" placeholder="S,M,L,XL" />
                        <span asp-validation-for="Size" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Material" class="form-label"></label>
                        <input asp-for="Material" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <h5>Giá & tồn kho</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" type="number" step="1000" min="0" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="SalePrice" class="form-label"></label>
                        <input asp-for="SalePrice" type="number" step="1000" min="0" class="form-control" placeholder="Để trống nếu không giảm" />
                        <span asp-validation-for="SalePrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="StockQuantity" class="form-label"></label>
                        <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-card">
                <h5>Hình ảnh</h5>

                <img id="imgPreview" src="@Model.ImageUrl"
                     class="img-preview mb-3 @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" alt="" />

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" data-preview="#imgPreview" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    <div class="form-text">JPG, PNG, WEBP – tối đa 5MB</div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="/images/products/... hoặc https://..." />
                </div>
            </div>

            <div class="admin-card">
                <h5>Hiển thị</h5>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label"></label>
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100 py-2">
                <i class="bi bi-check-lg"></i> @(isEdit ? "Lưu thay đổi" : "Thêm sản phẩm")
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
