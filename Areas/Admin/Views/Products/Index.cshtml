@model PagedList<Product>
@{
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sản phẩm <span class="text-muted fs-6">(@Model.TotalCount)</span></h4>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
</div>

<form method="get" class="admin-card row g-2 align-items-end">
    <div class="col-md-4">
        <label class="form-label small">Tìm kiếm</label>
        <input type="search" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên sản phẩm" />
    </div>
    <div class="col-md-3">
        <label class="form-label small">Danh mục</label>
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">Tất cả</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">Trạng thái</label>
        <select name="status" class="form-select">
            <option value="">Tất cả</option>
            <option value="active" selected="@(ViewBag.Status == "active")">Đang bán</option>
            <option value="hidden" selected="@(ViewBag.Status == "hidden")">Đang ẩn</option>
            <option value="featured" selected="@(ViewBag.Status == "featured")">Nổi bật</option>
            <option value="lowstock" selected="@(ViewBag.Status == "lowstock")">Sắp hết hàng</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-dark flex-fill">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
    </div>
</form>

<div class="admin-card p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-end">Giá</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-center">Nổi bật</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr class="@(p.IsActive ? "" : "opacity-50")">
                        <td>@p.ProductId</td>
                        <td><img src="@p.DisplayImage" class="admin-thumb" alt="" /></td>
                        <td>
                            <div class="fw-semibold">@p.ProductName</div>
                            <div class="small text-muted">@p.Brand?.BrandName</div>
                        </td>
                        <td>@p.Category?.CategoryName</td>
                        <td class="text-end">
                            @if (p.IsOnSale)
                            {
                                <div class="text-danger fw-semibold">@FormatHelper.Money(p.FinalPrice)</div>
                                <div class="small text-muted text-decoration-line-through">@FormatHelper.Money(p.Price)</div>
                            }
                            else
                            {
                                @FormatHelper.Money(p.Price)
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(p.StockQuantity == 0 ? "bg-danger" : p.StockQuantity <= ShopSettings.LowStockThreshold ? "bg-warning text-dark" : "bg-light text-dark")">
                                @p.StockQuantity
                            </span>
                        </td>
                        <td class="text-center">
                            <form asp-action="ToggleFeatured" asp-route-id="@p.ProductId" asp-route-returnUrl="@returnUrl" method="post">
                                <button class="btn btn-link p-0 fs-5 @(p.IsFeatured ? "text-warning" : "text-muted")" title="Bật/tắt nổi bật">
                                    <i class="bi @(p.IsFeatured ? "bi-star-fill" : "bi-star")"></i>
                                </button>
                            </form>
                        </td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@p.ProductId" asp-route-returnUrl="@returnUrl" method="post">
                                <button class="btn btn-sm @(p.IsActive ? "btn-success" : "btn-secondary")">
                                    @(p.IsActive ? "Đang bán" : "Đang ẩn")
                                </button>
                            </form>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId"
                               target="_blank" class="btn btn-sm btn-outline-secondary" title="Xem trên web"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.ProductId" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Không có sản phẩm</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var pager = new PagerViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        RouteValuesFor = p => new Dictionary<string, string>
        {
            ["q"] = (string?)ViewBag.Q ?? "",
            ["categoryId"] = ViewBag.CategoryId?.ToString() ?? "",
            ["status"] = (string?)ViewBag.Status ?? "",
            ["page"] = p.ToString()
        }
    };
}
<partial name="_Pager" model="pager" />
