@model PagedList<UserListItem>
@{
    var roles = (List<Role>)ViewBag.Roles;
    int currentUserId = ViewBag.CurrentUserId;
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<h4 class="mb-3">Người dùng <span class="text-muted fs-6">(@Model.TotalCount)</span></h4>

<form method="get" class="admin-card row g-2 align-items-end">
    <div class="col-md-6">
        <label class="form-label small">Tìm kiếm</label>
        <input type="search" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên đăng nhập, họ tên, email, SĐT" />
    </div>
    <div class="col-md-3">
        <label class="form-label small">Quyền</label>
        <select name="roleId" class="form-select" asp-items="ViewBag.RoleFilter">
            <option value="">Tất cả</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-dark flex-fill">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
    </div>
</form>

<div class="admin-card p-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Người dùng</th>
                    <th>Liên hệ</th>
                    <th>Ngày tạo</th>
                    <th class="text-center">Đơn hàng</th>
                    <th class="text-end">Đã chi tiêu</th>
                    <th>Quyền</th>
                    <th class="text-center">Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var u = item.User;
                    bool isSelf = u.UserId == currentUserId;

                    <tr class="@(u.IsActive ? "" : "table-secondary")">
                        <td>
                            <div class="fw-semibold">@u.FullName @(isSelf ? "(bạn)" : "")</div>
                            <div class="small text-muted">@u.Username</div>
                        </td>
                        <td class="small">
                            <div>@u.Email</div>
                            <div class="text-muted">@u.Phone</div>
                        </td>
                        <td class="small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@item.OrderCount</td>
                        <td class="text-end">@FormatHelper.Money(item.TotalSpent)</td>
                        <td>
                            <form asp-action="ChangeRole" asp-route-id="@u.UserId" asp-route-returnUrl="@returnUrl" method="post">
                                <select name="roleId" class="form-select form-select-sm js-auto-submit" disabled="@isSelf"
                                        style="width:110px">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r.RoleId" selected="@(r.RoleId == u.RoleId)">@r.RoleName</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@u.UserId" asp-route-returnUrl="@returnUrl" method="post"
                                  data-confirm="@(u.IsActive ? "Khóa" : "Mở khóa") tài khoản @u.Username?">
                                <button class="btn btn-sm @(u.IsActive ? "btn-success" : "btn-danger")" disabled="@isSelf">
                                    @(u.IsActive ? "Hoạt động" : "Đã khóa")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-dark">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var pager = new PagerViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        RouteValuesFor = p => new Dictionary<string, string>
        {
            ["q"] = (string?)ViewBag.Q ?? "",
            ["roleId"] = ViewBag.RoleId?.ToString() ?? "",
            ["page"] = p.ToString()
        }
    };
}
<partial name="_Pager" model="pager" />
