@model DashboardViewModel

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card d-flex justify-content-between">
            <div>
                <div class="stat-label">Doanh thu (đã thanh toán)</div>
                <div class="stat-value">@FormatHelper.Money(Model.TotalRevenue)</div>
                <div class="small text-success">Tháng này: @FormatHelper.Money(Model.RevenueThisMonth)</div>
            </div>
            <i class="bi bi-cash-stack stat-icon"></i>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-controller="Orders" asp-action="Index" asp-route-status="@OrderStatus.Pending" class="text-decoration-none text-dark">
            <div class="stat-card d-flex justify-content-between">
                <div>
                    <div class="stat-label">Tổng đơn hàng</div>
                    <div class="stat-value">@Model.TotalOrders</div>
                    <div class="small text-warning">@Model.PendingOrders đơn chờ xác nhận</div>
                </div>
                <i class="bi bi-receipt stat-icon"></i>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card d-flex justify-content-between">
            <div>
                <div class="stat-label">Khách hàng</div>
                <div class="stat-value">@Model.TotalCustomers</div>
                <div class="small text-muted">+@Model.NewCustomersThisMonth trong tháng</div>
            </div>
            <i class="bi bi-people stat-icon"></i>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card d-flex justify-content-between">
            <div>
                <div class="stat-label">Sản phẩm đang bán</div>
                <div class="stat-value">@Model.ActiveProducts</div>
                <div class="small text-danger">@Model.LowStockProducts.Count sản phẩm sắp hết hàng</div>
            </div>
            <i class="bi bi-box-seam stat-icon"></i>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="admin-card">
            <h5>Doanh thu 12 tháng gần nhất</h5>
            <canvas id="revenueChart" height="110"></canvas>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="admin-card">
            <h5>Đơn hàng theo trạng thái</h5>
            <canvas id="statusChart" height="220"></canvas>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="admin-card">
            <div class="d-flex justify-content-between">
                <h5>Đơn hàng mới nhất</h5>
                <a asp-controller="Orders" asp-action="Index" class="small">Xem tất cả</a>
            </div>
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày</th><th class="text-end">Tổng</th><th>Trạng thái</th></tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId">@o.OrderCode</a></td>
                            <td>@o.User.FullName</td>
                            <td class="small">@FormatHelper.DateTime(o.CreatedAt)</td>
                            <td class="text-end">@FormatHelper.Money(o.TotalAmount)</td>
                            <td><span class="badge @OrderStatus.BadgeClass(o.OrderStatus)">@o.OrderStatus</span></td>
                        </tr>
                    }
                    @if (Model.RecentOrders.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted">Chưa có đơn hàng</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="admin-card">
            <h5>Sản phẩm bán chạy</h5>
            @foreach (var p in Model.TopProducts)
            {
                <div class="d-flex align-items-center gap-3 mb-2">
                    <img src="@(p.ImageUrl ?? "/images/no-image.svg")" class="admin-thumb" style="width:40px;height:50px" alt="" />
                    <div class="flex-grow-1">
                        <div>@p.ProductName</div>
                        <div class="small text-muted">Đã bán @p.QuantitySold · @FormatHelper.Money(p.Revenue)</div>
                    </div>
                </div>
            }
            @if (Model.TopProducts.Count == 0)
            {
                <div class="text-muted small">Chưa có dữ liệu bán hàng</div>
            }
        </div>

        <div class="admin-card">
            <h5>Sắp hết hàng (≤ @ShopSettings.LowStockThreshold)</h5>
            @foreach (var p in Model.LowStockProducts)
            {
                <div class="d-flex justify-content-between border-bottom py-2">
                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId">@p.ProductName</a>
                    <span class="badge @(p.StockQuantity == 0 ? "bg-danger" : "bg-warning text-dark")">Còn @p.StockQuantity</span>
                </div>
            }
            @if (Model.LowStockProducts.Count == 0)
            {
                <div class="text-muted small">Tất cả sản phẩm đều đủ hàng</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const revenueLabels = @Json.Serialize(Model.RevenueLabels);
        const revenueValues = @Json.Serialize(Model.RevenueValues);
        const statusLabels = @Json.Serialize(Model.OrdersByStatus.Keys);
        const statusValues = @Json.Serialize(Model.OrdersByStatus.Values);

        new Chart(document.getElementById("revenueChart"), {
            type: "bar",
            data: {
                labels: revenueLabels,
                datasets: [{ label: "Doanh thu", data: revenueValues, backgroundColor: "#111" }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: { ticks: { callback: v => v.toLocaleString("vi-VN") + "đ" } }
                }
            }
        });

        new Chart(document.getElementById("statusChart"), {
            type: "doughnut",
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: ["#f0ad4e", "#5bc0de", "#0d6efd", "#198754", "#adb5bd"]
                }]
            },
            options: { plugins: { legend: { position: "bottom" } } }
        });
    </script>
}
